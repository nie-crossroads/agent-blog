spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/blogtest?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: your-db-username
    password: your-db-password
  mail:
    username: your-qq-email@qq.com
    password: your-qq-smtp-auth-code

blog:
  jwt:
    secret: change-me-to-a-long-random-string
  admin:
    username: ""
    reset-password: ""
  map:
    qq-key: ""
  uapi:
    qq-info-key: your-tianqi-qq-info-key
  storage:
    type: local
  cos:
    secret-id: ""
    secret-key: ""
    bucket: ""
    region: ""
    cdn-domain: ""
  cors:
    origins: http://localhost:80,http://127.0.0.1:80
  qiniu:
    access-key: ""
    secret-key: ""
    bucket: ""
    region: auto
    cdn-domain: ""
  site:
    title: your-blog-name
    msg-avatar: your-blog-avatar-url
    site-url: your-blog-url
